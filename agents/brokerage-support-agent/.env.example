# LLM provider: "auto" (default) uses Anthropic when ANTHROPIC_API_KEY is set,
# otherwise an offline keyword-routing mock. Force with "anthropic" or "mock".
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Demo customer selected by default in the UI.
DEFAULT_ACCOUNT_ID=ACCT-DEMO-1001
